{
  "name": "event-outbox-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Transactional outbox, at-least-once relay and idempotent consumer: a small reference implementation in TypeScript and Node.js",
  "license": "MIT",
  "author": "Hardyal Singh Deora <hardyalsinghdeora@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/migrations', 'dist/migrations', { recursive: true })\"",
    "start": "node --no-warnings=ExperimentalWarning dist/main.js",
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/main.ts | pino-pretty",
    "demo": "tsx --no-warnings=ExperimentalWarning src/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
